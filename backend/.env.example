APP_NAME=Personal Blog API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:3710,http://localhost:3710

# Database — use SQLite for local dev, or configure MySQL below
SQLITE_DB_PATH=blog.db

# MySQL (used when SQLITE_DB_PATH is not a .db file)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3715
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=blog

# IMPORTANT: Set a strong secret key for JWT signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Access token expiry in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP Email (optional — leave empty to skip emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@blog.com
FRONTEND_URL=http://localhost:3710

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Upload
MAX_UPLOAD_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/gif,image/webp,image/svg+xml

# DeepSeek API (optional — only needed for the AI chat feature)
# Create a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_TIMEOUT=120
