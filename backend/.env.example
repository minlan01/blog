APP_NAME=Personal Blog API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:3710,http://localhost:3710

# Database
# Use sqlite for local dev, mysql for Docker/production.
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=blog.db
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=blog
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=blog

# IMPORTANT: Set a strong secret key for JWT signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@blog.com
FRONTEND_URL=http://localhost:3710

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Upload
MAX_UPLOAD_SIZE_MB=1024
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/gif,image/webp,image/svg+xml,video/mp4,video/webm,video/quicktime,video/x-matroska

# Object storage
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minlan01
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=blog-media
MINIO_SECURE=false

# DeepSeek API (optional)
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_TIMEOUT=120
