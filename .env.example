# ──────────────────────────────────────────────
# Docker Compose environment variables
# Copy this file to ".env" and adjust as needed:
#   cp .env.example .env
# ──────────────────────────────────────────────

# JWT signing key for the backend.
# Leave EMPTY to auto-generate on first run (the key is persisted in the
# blog-data volume so JWT tokens stay valid across container restarts).
# To set your own, generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin account password (username: minlan01)
# Change this from the default for production!
ADMIN_DEFAULT_PASSWORD=minlan01

# Max image upload size in MB
MAX_UPLOAD_SIZE_MB=5

# DeepSeek API (optional — only needed for the AI chat feature)
# Create a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_TIMEOUT=120
